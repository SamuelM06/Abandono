# IPs del owner (tu equipo): separadas por coma. Solo estas IPs ven el boton de correo.
OWNER_IPS=127.0.0.1,::1

APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173
